    .d1(d1),
    .d2(d2),
    .d3(d3),
    .sel(sel),
    .y(y)
);

initial begin

d0 = 4'b1010;
d1 = 4'b0010;
d2 = 4'b1110;
d3 = 4'b1011;

sel = 2'b00;

#10;
sel = 2'b10;

#10;
sel = 2'b00;

#10;
sel = 2'b11;

#10;
sel = 2'b01;

#60;
$finish;
end

initial begin
$monitor (" d0=%b d1=%b d2=%b d3=%b sel=%b y=%b", d0, d1, d2, d3, sel, y);
end
endmodule
